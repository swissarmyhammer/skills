#!/bin/sh
# Makes one release of this marketplace (marketplace.md 3.2).
#
#   scripts/release <X.Y.Z>
#
# The script reads the two facts the release tool cannot read itself -- the
# state of the working tree, and the result of the test run -- and gives them to
# `swift run release`. The tool then holds the repository to each condition of a
# release and writes the new version into the VERSION file, into the
# metadata.version line of each SKILL.md, and into each catalog.
#
# The git steps are here and not in Swift: this package has no git library, and
# product code of this repository never starts `git`.
#
# The run makes the release commit and the release tag. It does not push. A
# person pushes with `git push --follow-tags` after they read the commit.
set -eu

if [ "$#" -ne 1 ]; then
    echo "usage: scripts/release <X.Y.Z>" >&2
    exit 1
fi
version="$1"
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 1

if [ -z "$(git -C "$root" status --porcelain)" ]; then
    working_tree=clean
else
    working_tree=dirty
fi

# The test run comes before the tool, because the tool refuses a release of a
# repository whose tests are red and cannot run them itself.
if swift test --package-path "$root"; then
    test_run=passed
else
    test_run=failed
fi

swift run --package-path "$root" release "$version" "$root" "$working_tree" "$test_run"
"$root/scripts/release-commit" "$version" "$root"
