#!/bin/sh
# Makes the release commit and the release tag of one repository.
#
#   scripts/release-commit <X.Y.Z> <repository root>
#
# `scripts/release` calls it after the release tool writes the files. It is a
# step of its own because the test suite runs it over a fixture repository, and
# thus the commit and the tag have a test.
#
# The tag is the letter v and the version, which is the name that CI reads back
# (ReleaseTag in Sources/CatalogGenerator). The run does not push.
set -eu

if [ "$#" -ne 2 ]; then
    echo "usage: scripts/release-commit <X.Y.Z> <repository root>" >&2
    exit 1
fi
version="$1"
root="$2"

git -C "$root" add --all
# The first release of a repository whose files already name the version adds
# no change. Git stops a commit that holds nothing, thus the run makes the
# commit only when there is one to make, and the tag marks the release either
# way.
if ! git -C "$root" diff --cached --quiet; then
    git -C "$root" commit --quiet --message "release: v$version"
fi
git -C "$root" tag "v$version"
